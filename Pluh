RunService.RenderStepped:Connect(function()
    if not Config.ESPEnabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if not ESPObjects[player] then CreateESP(player) end
            local obj = ESPObjects[player]
            local root = player.Character.HumanoidRootPart
            local head = player.Character:FindFirstChild("Head")
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if root and head and humanoid and humanoid.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    if Config.ESPBox then
                        local top = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
                        local bottom = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                        local height = math.abs(top.Y - bottom.Y)
                        local width = height * 0.6
                        obj.Container.Size = Vector2.new(width, height)
                        obj.Container.Position = Vector2.new(pos.X - width/2, pos.Y - height/2)
                        obj.Container.Visible = true
                    else
                        obj.Container.Visible = false
                    end
                    if Config.ESPName then
                        obj.NameTag.Text = player.Name
                        obj.NameTag.Position = Vector2.new(pos.X, pos.Y - 40)
                        obj.NameTag.Visible = true
                    else
                        obj.NameTag.Visible = false
                    end
                    if Config.ESPDistance then
                        local dist = math.floor((root.Position - Camera.CFrame.Position).Magnitude)
                        obj.DistTag.Text = dist .. " studs"
                        obj.DistTag.Position = Vector2.new(pos.X, pos.Y + 20)
                        obj.DistTag.Visible = true
                    else
                        obj.DistTag.Visible = false
                    end
                    if Config.ESPHealth then
                        local hp = humanoid.Health / humanoid.MaxHealth
                        local barH = 50
                        local barY = pos.Y - barH/2
                        obj.HealthBar.From = Vector2.new(pos.X - 40, barY)
                        obj.HealthBar.To = Vector2.new(pos.X - 40, barY + (barH * hp))
                        obj.HealthBar.Color = Color3.fromRGB(0, 255 - (255 * hp), 0)
                        obj.HealthBar.Visible = true
                    else
                        obj.HealthBar.Visible = false
                    end
                    if Config.ESPTracers then
                        obj.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        obj.Tracer.To = Vector2.new(pos.X, pos.Y)
                        obj.Tracer.Color = Color3.fromRGB(255, 255, 255)
                        obj.Tracer.Visible = true
                    else
                        obj.Tracer.Visible = false
                    end
                else
                    obj.Container.Visible = false
                    obj.NameTag.Visible = false
                    obj.DistTag.Visible = false
                    obj.HealthBar.Visible = false
                    obj.Tracer.Visible = false
                end
            else
                obj.Container.Visible = false
                obj.NameTag.Visible = false
                obj.DistTag.Visible = false
                obj.HealthBar.Visible = false
                obj.Tracer.Visible = false
            end
        end
    end
end)

-- Skin Changer
local skinColors = {
    Default = Color3.fromRGB(163, 162, 165),
    Gold = Color3.fromRGB(255, 215, 0),
    Diamond = Color3.fromRGB(185, 242, 255),
    Neon = Color3.fromRGB(57, 255, 20),
    Galaxy = Color3.fromRGB(75, 0, 130),
    Fire = Color3.fromRGB(255, 69, 0),
    Ice = Color3.fromRGB(173, 216, 230),
    Rainbow = Color3.fromRGB(255, 0, 255)
}

local function ApplySkin(char)
    if not Config.SkinChangerEnabled then return end
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            if Config.SelectedSkin == "Rainbow" then
                part.Color = Color3.fromHSV(tick() % 1, 1, 1)
            else
                part.Color = skinColors[Config.SelectedSkin] or skinColors.Default
            end
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    ApplySkin(char)
end)

if LocalPlayer.Character then ApplySkin(LocalPlayer.Character) end

RunService.Heartbeat:Connect(function()
    if Config.SkinChangerEnabled and Config.SelectedSkin == "Rainbow" and LocalPlayer.Character then
        ApplySkin(LocalPlayer.Character)
    end
end)

-- Cleanup
Players.PlayerRemoving:Connect(function(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            if obj.Remove then obj:Remove() end
        end
        ESPObjects[player] = nil
    end
end)
